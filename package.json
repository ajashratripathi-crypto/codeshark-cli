{
  "name": "codeshark-cli",
  "version": "0.1.5",
  "description": "An open-source terminal coding agent. Eight model choices, project tools, and approval before every tool action.",
  "type": "module",
  "bin": {
    "codeshark": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "TERMS.md",
    "PRIVACY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajashratripathi-crypto/codeshark-cli.git"
  },
  "homepage": "https://github.com/ajashratripathi-crypto/codeshark-cli#readme",
  "bugs": {
    "url": "https://github.com/ajashratripathi-crypto/codeshark-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "start": "node dist/index.js",
    "banner": "node dist/index.js banner",
    "worker:build": "tsc -p worker/tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "coding-agent",
    "terminal",
    "llm"
  ],
  "license": "MIT",
  "author": "CodeShark contributors",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
